<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<RootNamespace>Engine4.Client</RootNamespace>
		<AssemblyName>Engine4.Client</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- Includes -->
	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all"/>
		<PackageReference Include="OpenTK" Version="5.0.0-pre.16"/>
		<PackageReference Include="Silk.NET.Shaderc" Version="2.23.0"/>

		<ProjectReference Include="..\Engine4\Engine4.csproj"/>

		<EmbeddedResource Include="Assets\**"/>
	</ItemGroup>

	<!-- Release -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="Src\Graphics\Vulkan\Objects\VulkanDebugMessenger.cs"/>
	</ItemGroup>

	<!-- OS specific stuff -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>OS_WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>OS_LINUX</DefineConstants>
	</PropertyGroup>
</Project>